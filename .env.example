# Copy this file to ".env" and fill in real values. NEVER commit .env to GitHub.

# IMPORTANT: use the SAME MongoDB connection string AND database as the Execution Portal,
# so both portals share the handover records. (Copy MONGO_URI from the Execution Portal's
# Backend/.env — the database name in the URI must be identical.)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Sales Portal users live in "sp_" collections. Handover records are shared with the
# Execution Portal in "ho_" collections. Keep these the same in BOTH portals.
SALES_PREFIX=sp_
HANDOVER_PREFIX=ho_

# JWT signing key – at least 32 random characters. Generate one with:  npm run gen:secret
# (This can be different from the Execution Portal's secret — each portal signs its own logins.)
JWT_SECRET=<paste-output-of-npm-run-gen:secret>
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

PORT=5100
NODE_ENV=development
TZ_NAME=Asia/Kolkata
# Frontend URL(s) allowed to call the API, comma separated. Use your domain in production, * only for local testing.
CORS_ORIGIN=*
